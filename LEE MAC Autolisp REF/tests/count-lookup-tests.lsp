;; Native DXF inserts with different names and three evaluated preview records.
(defun ct:makeblock ( name )
    (entmake (list '(0 . "BLOCK") (cons 2 name) '(70 . 0) '(10 0.0 0.0 0.0)))
    (entmake '((0 . "LINE") (10 0.0 0.0 0.0) (11 10.0 0.0 0.0)))
    (entmake '((0 . "ENDBLK"))))
(ct:makeblock "CT-A")
(ct:makeblock "CT-B")
(ct:makeblock "CT-C")
(setq ct:ss (ssadd) ct:data nil)
(foreach ct:spec '(("CT-A" "A") ("CT-B" "A") ("CT-A" "B") ("CT-C" "C") ("CT-B" "B") ("CT-C" "C"))
    (setq ct:e (entmakex (list '(0 . "INSERT") (cons 2 (car ct:spec)) '(10 0.0 0.0 0.0))))
    (ssadd ct:e ct:ss)
    (setq ct:data (cons (list ct:e (cons "Size" (cadr ct:spec))) ct:data)))
(defun count:entitylookupentry ( ent spec )
    (count:lookupentry (cdr (assoc ent ct:data)) spec))
