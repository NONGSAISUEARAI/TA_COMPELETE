;; Run with run-count-lookup.scr in AutoCAD Core Console.
;; Native getint is exercised by the script; COM discovery is stubbed.
(setq ct:failed 0 ct:passed 0)
(defun ct:check ( label condition )
    (if condition
        (progn (setq ct:passed (1+ ct:passed)) (princ (strcat "\nPASS " label)))
        (progn (setq ct:failed (1+ ct:failed)) (princ (strcat "\nFAIL " label)))))
(ct:check "exact literal wildcard value" (not (count:lookupvalueequal "A*" "ABC")))
(ct:check "case insensitive value" (count:lookupvalueequal "Type-A" "TYPE-A"))
(ct:check "numeric value" (count:lookupvalueequal 100 100.0))
(ct:check "typed value" (not (count:lookupvalueequal "100" 100)))
(ct:check "value union" (equal '("A" "B") (count:appendvalue "B" (count:appendvalue "a" '("A" "B")))))
(setq ct:records (count:addlookuprecord "Size" '("A" "B") nil))
(setq ct:records (count:addlookuprecord "Size" '("B" "C") ct:records))
(ct:check "one property across block names" (= 1 (length ct:records)))
(ct:check "merge allowed values" (equal '("A" "B" "C") (caddr (car ct:records))))
(setq ct:records (count:addlookuprecord "Other" '("X") ct:records))
(ct:check "all summary" (= " {LOOKUP=Size=All}"
    (count:filterdescription '((lookup "Size" all)))))
(ct:check "integer summary" (= " {LOOKUP=Size=100}"
    (count:filterdescription '((lookup "Size" 100)))))
;; Deterministic catalog; native selectlookup/menuint and preference IO unchanged.
(defun count:lookupcatalog ( sel ) ct:records)
(setq count:savepath (getvar "TEMPPREFIX"))
;; Use an isolated directory below the test workspace, provided by the script.
(setq count:savepath ct:savepath)
;; Upgrade the original block-scoped saved preferences.
(count:writecfg (strcat count:savepath "\\TA_count_V1-6_lookup.cfg")
    (list '((last "BLOCK-A" "SIZE") (("BLOCK-A" "SIZE") . "A"))))
(ct:check "legacy preferences upgraded" (equal "SIZE" (cdr (assoc 'last (count:lookupmemory)))))
(ct:check "legacy value upgraded" (equal "A" (cdr (assoc "SIZE" (count:lookupmemory)))))
(princ "\nTEST select second property; reject 99; choose value 1.")
(setq ct:chosen (count:selectlookup 'selection nil))
(ct:check "numbered property/value" (equal '("Other" "X") ct:chosen))
(ct:check "saved identity" (equal "OTHER" (cdr (assoc 'last (count:lookupmemory)))))
;; Reverse names AND values to prove we remember identities rather than indices.
(setq ct:records (reverse ct:records))
(princ "\nTEST Enter twice should recall Other / X after reorder.")
(setq ct:chosen (count:selectlookup 'selection nil))
(ct:check "reordered default" (equal '("Other" "X") ct:chosen))
(princ "\nTEST accept remembered property and choose All.")
(setq ct:chosen (count:selectlookup 'selection nil))
(ct:check "all selection" (equal '("Other" all) ct:chosen))
(ct:check "all saved" (= 'all (cdr (assoc "OTHER" (count:lookupmemory)))))
(princ "\nTEST Back returns no filter.")
(ct:check "back" (null (count:selectlookup 'selection nil)))
;; Stub only COM discovery: run the actual matching/grouping/report functions.
(defun count:dynamicpairs ( obj ) obj)
(ct:check "specific value match" (count:matchlookup '(("Size" . "A")) '("Size" "A")))
(ct:check "specific value reject" (not (count:matchlookup '(("Size" . "B")) '("Size" "A"))))
(ct:check "All requires selected property" (not (count:matchlookup '(("Other" . "A")) '("Size" all))))
(ct:check "All includes any value" (count:matchlookup '(("Size" . "B")) '("Size" all)))
(ct:check "empty text value exists" (count:matchlookup '(("Size" . "")) '("Size" all)))
;; Native DXF inserts with different names and three evaluated preview records.
(defun ct:makeblock ( name )
    (entmake (list '(0 . "BLOCK") (cons 2 name) '(70 . 0) '(10 0.0 0.0 0.0)))
    (entmake '((0 . "LINE") (10 0.0 0.0 0.0) (11 10.0 0.0 0.0)))
    (entmake '((0 . "ENDBLK"))))
(ct:makeblock "CT-A")
(ct:makeblock "CT-B")
(ct:makeblock "CT-C")
(setq ct:ss (ssadd) ct:data nil)
(foreach ct:spec '(("CT-A" "A") ("CT-B" "A") ("CT-A" "B") ("CT-C" "C") ("CT-B" "B") ("CT-C" "C"))
    (setq ct:e (entmakex (list '(0 . "INSERT") (cons 2 (car ct:spec)) '(10 0.0 0.0 0.0))))
    (ssadd ct:e ct:ss)
    (setq ct:data (cons (list ct:e (cons "Size" (cadr ct:spec))) ct:data)))
(defun count:entitylookupentry ( ent spec )
    (count:lookupentry (cdr (assoc ent ct:data)) spec))
(setq ct:report (count:buildreport ct:ss '("Size" all)))
(ct:check "All splits 6 refs into 5 Name plus Lookup rows" (= 5 (length ct:report)))
(ct:check "total counts all 6 across block names" (= 6 (apply '+ (mapcar 'cadr ct:report))))
(ct:check "same value keeps different block names separate" (= 2 (length (vl-remove-if-not '(lambda (r) (= "A" (car r))) ct:report))))
(ct:check "same name and value combine" (= 2 (cadr (assoc "C" ct:report))))
(ct:check "representative preview is actual record" (= "CT-C" (caddr (assoc "C" ct:report))))
(ct:check "distinct values have distinct previews" (/= (caddr (assoc "B" ct:report)) (caddr (assoc "C" ct:report))))
(ct:check "CSV/text includes Name Lookup Count"
    (equal '(("CT-A" "A" "1") ("CT-B" "A" "1") ("CT-A" "B" "1") ("CT-C" "C" "2") ("CT-B" "B" "1"))
           (count:reporttextrows ct:report "1" t)))
(setq ct:specific (count:buildreport ct:ss '("Size" "A")))
(ct:check "specific value includes two named rows" (and (= 2 (length ct:specific)) (= 2 (apply '+ (mapcar 'cadr ct:specific)))))
(setq ct:legacy (count:buildreport ct:ss nil))
(ct:check "original Block count mode preserved" (= 3 (length ct:legacy)))
(ct:check "sort tied quantities retains rows" (= 5 (length (vl-sort-i ct:report '(lambda (a b) (< (cadr a) (cadr b)))))))
(ct:check "all names discovered" (equal '("CT-A" "CT-B" "CT-C") (count:blocknames ct:ss)))
(ct:check "include multiple names" (count:matchname "CT-B" '(include "CT-A" "CT-B")))
(ct:check "exclude names" (not (count:matchname "CT-B" '(exclude "CT-B"))))
(ct:check "case insensitive exact name" (count:matchname "CT-A" '(include "ct-a")))
(ct:check "all names" (count:matchname "CT-A" '(all)))
(ct:check "old wildcard names" (count:matchname "CT-A" "CT-*"))
(setq ct:filtered (count:filterselection ct:ss '((name include "CT-A" "CT-C") (lookup "Size" all))))
(ct:check "multiple names AND Lookup" (= 4 (sslength ct:filtered)))
(ct:check "initial selection retains all names" (= 6 (sslength ct:ss)))
(setq ct:filtered (count:filterselection ct:ss '((lookup "Size" "A") (name exclude "CT-A"))))
(ct:check "Lookup AND Name works in reverse order" (= 1 (sslength ct:filtered)))
(ct:check "filtered lookup report Name" (= "CT-B" (cadddr (car (count:buildreport ct:filtered '("Size" "A"))))))
(ct:check "name filter description"
    (= " {NAME=INCLUDE: CT-A, CT-C}" (count:filterdescription '((name include "CT-A" "CT-C")))))
;; Pickfirst accepts the complete mixed-name selection without an extra prompt.
(setq ct:pickfirst (getvar "PICKFIRST"))
(setvar "PICKFIRST" 1)
(sssetfirst nil ct:ss)
(setq ct:selected (count:selectblocks '((0 . "INSERT")) ct:ss))
(ct:check "mixed-name preselection accepted" (= 6 (sslength ct:selected)))
(sssetfirst nil nil)
(setvar "PICKFIRST" ct:pickfirst)
(princ "\nTEST manual ssget accepts All mixed-name inserts, then Enter.")
(setq ct:selected (count:selectblocks '((0 . "INSERT")) ct:ss))
(ct:check "manual mixed-name selection" (= 6 (sslength ct:selected)))
(ct:check "manual selection retains three names" (= 3 (length (count:blocknames ct:selected))))
(princ "\nTEST Name Include 1 and 3, then Enter.")
(setq ct:names (count:selectnames ct:ss nil))
(ct:check "numbered multi-name menu" (equal '(include "CT-A" "CT-C") ct:names))
(princ "\nTEST Name Exclude 2, then Enter.")
(setq ct:names (count:selectnames ct:ss nil))
(ct:check "numbered exclude menu" (equal '(exclude "CT-B") ct:names))
(princ "\nTEST toggle same number twice leaves no included names.")
(setq ct:names (count:selectnames ct:ss nil))
(ct:check "toggle removes name" (equal '(include) ct:names))
(ct:check "no included names matches none" (not (count:matchname "CT-A" ct:names)))
(princ "\nTEST 0 restores All names.")
(setq ct:names (count:selectnames ct:ss '(include "CT-A")))
(ct:check "zero restores all" (equal '(all) ct:names))
(ct:check "Block first then Lookup ascending"
    (equal '(("CT-A" "A" "1") ("CT-A" "B" "1") ("CT-B" "A" "1") ("CT-B" "B" "1") ("CT-C" "C" "2"))
           (count:reporttextrows (count:sortreport (reverse ct:report) "blk" "asc") "1" t)))
(ct:check "Block first then Lookup descending"
    (equal '(("CT-C" "C" "2") ("CT-B" "B" "1") ("CT-B" "A" "1") ("CT-A" "B" "1") ("CT-A" "A" "1"))
           (count:reporttextrows (count:sortreport ct:report "blk" "des") "1" t)))
(ct:check "quantity sort for other outputs preserved"
    (equal '(1 1 1 1 2) (mapcar 'cadr (count:sortreport ct:report "qty" "asc"))))
(ct:check "equal sort keys keep every row"
    (= 6 (length (count:sortreport (append ct:report (list (car ct:report))) "blk" "asc"))))
(setq ct:sorted (count:sortreport ct:report "blk" "asc"))
(ct:check "merge names with title keeps header separate"
    (equal '((2 . 3) (4 . 5)) (count:namemergegroups ct:sorted 2 t)))
(ct:check "merge names without title keeps header separate"
    (equal '((1 . 2) (3 . 4)) (count:namemergegroups ct:sorted 1 t)))
(ct:check "merge preset disabled" (null (count:namemergegroups ct:sorted 2 nil)))
(ct:check "single row never merges" (null (count:namemergegroups (list (car ct:sorted)) 2 t)))
(ct:check "empty report never merges" (null (count:namemergegroups nil 2 t)))
(ct:check "descending names handle trailing multirow group"
    (equal '((3 . 4) (5 . 6)) (count:namemergegroups (reverse ct:sorted) 2 t)))
(ct:check "separated equal names never merge across other blocks"
    (null (count:namemergegroups (list (nth 0 ct:sorted) (nth 2 ct:sorted) (nth 1 ct:sorted)) 2 t)))
(princ (strcat "\nCOUNT_LOOKUP_TESTS: " (itoa ct:passed) " passed, " (itoa ct:failed) " failed.\n"))
(princ)
