SECURELOAD
0
(load "C:/TA/TA_COMPELETE/tmp/ta_cell_area_test/real_v2.lsp")
(setq TCT:insunits (getvar "INSUNITS"))
(TCA:Label '(500.0 500.0 0.0) 25.0 1.0)
(setq TCT:insert (entlast) TCT:record (cdr (assoc 330 (entget (tblobjname "BLOCK" tca:block)))))
(TCT:Assert (= 4 (cdr (assoc 70 (entget TCT:record)))) "existing facade block units are millimeters")
(TCT:Assert (equal 25.0 (cdr (assoc 41 (entget TCT:insert))) 1e-7) "preset insertion scale unchanged")
(TCT:Assert (= TCT:insunits (getvar "INSUNITS")) "drawing units restored after insertion")
(entmod (subst '(70 . 0) (assoc 70 (entget TCT:record)) (entget TCT:record)))
(setq TCT:insert-before (entget TCT:insert) TCT:attrs-before (TCT:Attributes TCT:insert) TCT:definition-before (TCT:Definition))
TCAUNIT
(TCT:Assert (= 4 (cdr (assoc 70 (entget TCT:record)))) "TCAUNIT updates old unitless block to millimeters")
(TCT:Assert (equal TCT:insert-before (entget TCT:insert)) "existing insertion position and scale unchanged")
(TCT:Assert (equal TCT:attrs-before (TCT:Attributes TCT:insert)) "existing attributes unchanged")
(TCT:Assert (equal TCT:definition-before (TCT:Definition)) "block geometry and attribute definition unchanged")
(TCT:Assert (= TCT:insunits (getvar "INSUNITS")) "TCAUNIT does not change drawing units")
(setq tca:block "TA-UNIT-MM-TEST")
(TCA:InfoBlock)
(setq TCT:record (cdr (assoc 330 (entget (tblobjname "BLOCK" tca:block)))))
(TCT:Assert (= 4 (cdr (assoc 70 (entget TCT:record)))) "new attribute block units are millimeters")
(princ (strcat "\nBLOCK_UNIT_TEST_FAILURES=" (itoa TCT:failures)))
_.QUIT
_Yes
