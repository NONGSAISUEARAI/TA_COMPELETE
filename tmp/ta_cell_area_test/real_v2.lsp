(load "C:/TA/TA_COMPELETE/GPT CODE/TA_CELL_AREA/TA_CELL_AREA.lsp")
(setq tca:filter "Area")
(setq TCT:failures 0)
(defun TCT:Assert (condition name)
  (princ (strcat "\nTEST " name "=" (if condition "PASS" "FAIL")))
  (if (not condition) (setq TCT:failures (1+ TCT:failures))))
(defun TCT:Clear () (command-s "_.ERASE" "_All" ""))
(defun TCT:Line (a b)
  (entmake (list '(0 . "LINE") (cons 10 (trans a 1 0)) (cons 11 (trans b 1 0)))))
(defun TCT:Path (points / first)
  (setq first (car points))
  (while (cdr points)
    (TCT:Line (car points) (cadr points)) (setq points (cdr points)))
  (TCT:Line (car points) first))
(defun TCT:GridSS () (ssget "_X" '((0 . "LINE,LWPOLYLINE,POLYLINE,XLINE"))))
(defun TCT:Mixed (/ x y)
  (TCT:Clear)
  (foreach x '(0.0 2000.0)
    (entmake (list '(0 . "XLINE") '(100 . "AcDbEntity") '(100 . "AcDbXline")
      (cons 10 (list x 0.0 0.0)) '(11 0.0 1.0 0.0))))
  (foreach y '(0.0 2000.0)
    (entmake (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity")
      '(100 . "AcDbPolyline") '(90 . 2) '(70 . 0)
      (cons 10 (list 0.0 y)) (cons 10 (list 2000.0 y)))))
  (TCT:Line '(1000.0 0.0 0.0) '(1000.0 2000.0 0.0))
  (TCT:Line '(0.0 1000.0 0.0) '(2000.0 1000.0 0.0)))
(TCT:Mixed)
(setq TCT:faces (TCA:GridFaces (TCT:GridSS)))
(TCT:Assert (= 4 (length TCT:faces)) "mixed L PL XL faces")
(TCT:Assert (equal 4000000.0 (apply '+ (mapcar 'caddr TCT:faces)) 1e-6) "mixed grid exact area")
(TCA:Layer "TA-CELL-BOUNDARY" 3)
(TCA:Layer "TA-CELL-AREA" 2)
(setq TCT:index 0)
(foreach TCT:face TCT:faces
  (setq TCT:index (1+ TCT:index))
  (TCT:Assert (TCA:PutFace TCT:face 40.0 1e-6 " m2" TCT:index 0.0) "actual boundary and label creation"))
(setq TCT:out (ssget "_X" '((0 . "LWPOLYLINE") (8 . "TA-CELL-BOUNDARY"))))
(TCT:Assert (= 4 (sslength TCT:out)) "four output boundaries")
(setq TCT:index 0 TCT:sum 0.0)
(repeat (sslength TCT:out)
  (setq TCT:sum (+ TCT:sum (vlax-curve-getArea (ssname TCT:out TCT:index)))
        TCT:index (1+ TCT:index)))
(TCT:Assert (equal TCT:sum 4000000.0 1e-6) "actual AutoCAD curve area")
(TCT:Assert (null (TCA:PutFace (car TCT:faces) 40.0 1e-6 " m2" 5 1.1)) "minimum area filter")
(setq TCT:last (entlast))
(TCT:Assert (null (TCA:PutFace (car TCT:faces) 40.0 1e-6 " m2" 5 1.0)) "area equal to threshold is rejected")
(TCT:Assert (eq TCT:last (entlast)) "rejected area creates no outline or label")
(TCT:Assert (TCA:PutFace (car TCT:faces) 40.0 1e-6 " m2" 5 0.9) "area above threshold is accepted")

;;; A concave cell, with a dangling line extending into it.
(TCT:Clear)
(TCT:Path '((0.0 0.0 0.0) (2000.0 0.0 0.0) (2000.0 1000.0 0.0)
            (1000.0 1000.0 0.0) (1000.0 2000.0 0.0) (0.0 2000.0 0.0)))
(TCT:Line '(500.0 0.0 0.0) '(500.0 500.0 0.0))
(setq TCT:faces (TCA:GridFaces (TCT:GridSS)))
(TCT:Assert (= 1 (length TCT:faces)) "concave cell with dangling edge")
(TCT:Assert (equal 3000000.0 (caddr (car TCT:faces)) 1e-6) "concave cell area")
(TCT:Assert (= 6 (length (caar TCT:faces))) "dangling edge removed from outline")
(TCT:Assert (TCA:Inside (cadr (car TCT:faces)) (caar TCT:faces)) "label seed inside concave cell")

;;; Open perimeter must never be closed artificially.
(TCT:Clear)
(TCT:Line '(0.0 0.0 0.0) '(2000.0 0.0 0.0))
(TCT:Line '(0.0 0.0 0.0) '(0.0 1000.0 0.0))
(TCT:Line '(2000.0 0.0 0.0) '(2000.0 1000.0 0.0))
(TCT:Line '(0.0 1000.0 0.0) '(999.0 1000.0 0.0))
(TCT:Line '(1001.0 1000.0 0.0) '(2000.0 1000.0 0.0))
(TCT:Assert (null (TCA:GridFaces (TCT:GridSS))) "gap does not create false closed cell")

;;; Overlapping source lines must not duplicate a face.
(TCT:Clear)
(TCT:Path '((0.0 0.0 0.0) (2000.0 0.0 0.0) (2000.0 1000.0 0.0) (0.0 1000.0 0.0)))
(TCT:Line '(500.0 0.0 0.0) '(1500.0 0.0 0.0))
(setq TCT:faces (TCA:GridFaces (TCT:GridSS)))
(TCT:Assert (= 1 (length TCT:faces)) "overlapping segments do not duplicate area")

;;; Restore mixed grid for the real interactive TCAA command test.
;;; Verify graph and output coordinates under a rotated UCS at nonzero Z.
(TCT:Clear)
(command-s "_.UCS" "_Z" "30")
(TCT:Path '((1000000.0 1000000.0 50.0) (1002000.0 1000000.0 50.0)
            (1002000.0 1001000.0 50.0) (1000000.0 1001000.0 50.0)))
(setq TCT:faces (TCA:GridFaces (TCT:GridSS)))
(TCT:Assert (= 1 (length TCT:faces)) "rotated UCS face")
(TCT:Assert (equal 2000000.0 (caddr (car TCT:faces)) 0.01) "large coordinate area")
(TCT:Assert (TCA:PutFace (car TCT:faces) 40.0 1e-6 " m2" 1 0.0) "rotated UCS actual output")
(setq TCT:out (ssget "_X" '((0 . "LWPOLYLINE") (8 . "TA-CELL-BOUNDARY"))))
(TCT:Assert (equal 2000000.0 (vlax-curve-getArea (ssname TCT:out 0)) 0.01) "rotated UCS output curve area")
(command-s "_.UCS" "_World")
(TCT:Mixed)
;;; Reuse a customized definition derived from the user's actual reference.
(load "C:/TA/TA_COMPELETE/GPT CODE/TA_FACADE_OUTLINE/TA_FACADE_OUTLINE.lsp")
(setq TCT:schema (TFO:InfoSchema))
(entmake '((0 . "BLOCK") (2 . "facade_1_INFO") (70 . 2) (10 5.0 7.0 0.0)))
(foreach TCT:data TCT:schema
  (if (and (= "ATTDEF" (cdr (assoc 0 TCT:data))) (= "MAT" (cdr (assoc 2 TCT:data))))
    (setq TCT:data (subst '(10 3.0 0.8 0.0) (assoc 10 TCT:data) TCT:data)
          TCT:data (subst '(11 3.0 0.8 0.0) (assoc 11 TCT:data) TCT:data)))
  (entmake TCT:data))
(entmake '((0 . "ATTDEF") (100 . "AcDbEntity") (8 . "0") (100 . "AcDbText")
  (10 0.0 -4.0 0.0) (11 0.0 -4.0 0.0) (40 . 1.0) (1 . "KEEP-ME") (7 . "Standard")
  (100 . "AcDbAttributeDefinition") (280 . 0) (3 . "EXTRA") (2 . "EXTRA") (70 . 0) (74 . 0) (280 . 1)))
(entmake '((0 . "ENDBLK")))
(defun TCT:Definition (/ en result)
  (setq en (cdr (assoc -2 (tblsearch "BLOCK" "facade_1_INFO"))))
  (while (and en (/= "ENDBLK" (cdr (assoc 0 (entget en)))))
    (setq result (cons (entget en) result) en (entnext en)))
  result)
(defun TCT:Attributes (insert / en data values)
  (setq en insert)
  (while (and (setq en (entnext en)) (/= "SEQEND" (cdr (assoc 0 (setq data (entget en))))))
    (if (= "ATTRIB" (cdr (assoc 0 data)))
      (setq values (cons (cons (cdr (assoc 2 data)) (cdr (assoc 1 data))) values))))
  values)
(setq TCT:defbefore (TCT:Definition))
(setq TCT:sources (TCT:GridSS) TCT:before nil TCT:index 0)
(repeat (sslength TCT:sources)
  (setq TCT:before (cons (entget (ssname TCT:sources TCT:index)) TCT:before)
        TCT:index (1+ TCT:index)))
(setq TCT:vars (mapcar '(lambda (v) (cons v (getvar v)))
  '("CMDECHO" "OSMODE" "CLAYER" "PLINETYPE" "HPGAPTOL" "ATTREQ" "ATTDIA" "ANGBASE" "ANGDIR" "AUNITS")))
(princ)
