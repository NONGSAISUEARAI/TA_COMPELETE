SIZE MAT
SIZE STATION
SIZE FLOOR
(setq TCT:labels (ssget "_X" '((0 . "INSERT") (2 . "facade_1_INFO") (8 . "TA-FACADE-INFO"))))
(TCT:Assert (and TCT:labels (= 2 (sslength TCT:labels))) "only two qualifying rectangles create blocks in either orientation")
(setq TCT:index 0)
(repeat (sslength TCT:labels) (setq TCT:attrs (TCT:Attributes (ssname TCT:labels TCT:index)) TCT:index (1+ TCT:index)) (TCT:Assert (and (equal 1.0 (atof (cdr (assoc "AREA" TCT:attrs))) 1e-6) (= "SIZE MAT" (cdr (assoc "MAT" TCT:attrs)))) "area and metadata still written correctly"))
(princ (strcat "\nSIZE_TEST_FAILURES=" (itoa TCT:failures)))
_.QUIT
