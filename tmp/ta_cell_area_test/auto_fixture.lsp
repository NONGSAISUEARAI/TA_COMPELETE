;;; Tests candidate generation with actual LINE, PLINE and XLINE objects.
;;; Core Console lacks BOUNDARY; use known rectangular boundaries only for
;;; testing the downstream calculation/label workflow, not boundary tracing.
(load "C:/TA/TA_COMPELETE/GPT CODE/TA_CELL_AREA/TA_CELL_AREA.lsp")
(command-s "_.ERASE" "_All" "")
(foreach x '(0.0 2000.0)
  (entmake (list '(0 . "XLINE") '(100 . "AcDbEntity") '(100 . "AcDbXline")
    (cons 10 (list x 0.0 0.0)) '(11 0.0 1.0 0.0))))
(foreach y '(0.0 2000.0)
  (entmake (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity")
    '(100 . "AcDbPolyline") '(90 . 2) '(70 . 0)
    (cons 10 (list 0.0 y)) (cons 10 (list 2000.0 y)))))
(entmake '((0 . "LINE") (10 1000.0 0.0 0.0) (11 1000.0 2000.0 0.0)))
(entmake '((0 . "LINE") (10 0.0 1000.0 0.0) (11 2000.0 1000.0 0.0)))
(setq test-grid (ssget "_X" '((0 . "LINE,LWPOLYLINE,XLINE"))))
(setq test-seeds (TCA:AutoSeeds test-grid))
(if (/= 4 (length test-seeds)) (TCA:Fail "TEST FAIL: expected four candidate points."))
(princ "\nTEST_MIXED_GRID_SEEDS=PASS")
(setq test-sources nil test-index 0)
(repeat (sslength test-grid)
  (setq test-sources (cons (entget (ssname test-grid test-index)) test-sources)
        test-index (1+ test-index)))
(defun TCA:Boundary (ss point / x y)
  (setq x (* 1000.0 (fix (/ (car point) 1000.0)))
        y (* 1000.0 (fix (/ (cadr point) 1000.0))))
  (entmake (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity")
    '(100 . "AcDbPolyline") '(90 . 4) '(70 . 1)
    (cons 10 (list x y)) (cons 10 (list (+ x 1000) y))
    (cons 10 (list (+ x 1000) (+ y 1000))) (cons 10 (list x (+ y 1000)))))
  (entlast))
(princ)
