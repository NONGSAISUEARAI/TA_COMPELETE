(setvar "SECURELOAD" 0)
(load "C:/Users/tawan.t/Documents/GitHub/TA_COMPELETE/GPT CODE/TA_FACADE_OUTLINE/TA_FACADE_OUTLINE.lsp")
(setq ct-log (open "C:/Users/tawan.t/Documents/GitHub/TA_COMPELETE/tmp/ta_facade_outline_validation/curve_types.txt" "w"))
(entmake '((0 . "LINE") (10 0.0 0.0 0.0) (11 30.0 40.0 0.0)))
(setq ct-line (entlast))
(entmake '((0 . "ARC") (10 100.0 100.0 0.0) (40 . 10.0) (50 . 0.0) (51 . 1.5707963267948966)))
(setq ct-arc (entlast))
(entmake '((0 . "CIRCLE") (10 200.0 100.0 0.0) (40 . 10.0)))
(setq ct-circle (entlast))
(foreach ct-case (list (list ct-line 50.0) (list ct-arc (* 5.0 pi)) (list ct-circle (* 20.0 pi))) (foreach ct-mode '("MAX" "OVERALL") (setq ct-r (vl-catch-all-apply 'TFO:LengthSegments (list (car ct-case) ct-mode))) (write-line (strcat ct-mode " " (if (and (not (vl-catch-all-error-p ct-r)) (= 1 (length ct-r)) (equal (caar ct-r) (cadr ct-case) 1e-7)) "PASS" "FAIL") " " (vl-prin1-to-string ct-r)) ct-log)))
(setq ct-ss (ssadd))
(foreach ct-e (list ct-line ct-arc ct-circle) (ssadd ct-e ct-ss))
(setq ct-r (TFO:SideLengthBuild ct-ss "CURVE TEST" "OVERALL"))
(write-line (strcat "MIXED INSERT " (if (= 3 (length ct-r)) "PASS" "FAIL")) ct-log)
(setq ct-r (TFO:CustomLengthBuild (list ct-circle '(210.0 100.0 0.0)) "CUSTOM CIRCLE"))
(write-line (strcat "CUSTOM CIRCLE INSERT " (if (and (= 1 (length ct-r)) (equal (* 20.0 pi) (nth 2 (car ct-r)) 1e-7)) "PASS" "FAIL")) ct-log)
(close ct-log)
_.QUIT
_Y
