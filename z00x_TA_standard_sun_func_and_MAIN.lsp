        (progn
          (setq blk_obj_ins_ (vlax-safearray->list (vlax-variant-value (vla-get-insertionpoint blk_obj_))))
          (cond
            (;aixs_case_1
              (and 
                (= (strcase axis_set_) "X")
                (= (numberp axis_val_) T)
              )
              (progn
                (vla-put-insertionpoint blk_obj_ 
                                        (vlax-3d-point (list
                                                          (+ (car blk_obj_ins_) axis_val_)
                                                          (+ (cadr blk_obj_ins_) 0)
                                                          (+ (caddr blk_obj_ins_) 0)
                                                        )
                                        )
                )
                (princ "aixs_case_1")
              )
            )
            (;aixs_case_2
              (and
                  (= (strcase axis_set_ ) "Y")
                  (= (numberp axis_val_) T)
              )
              (progn
                (vla-put-insertionpoint blk_obj_ 
                                        (vlax-3d-point (list
                                                          (+ (car blk_obj_ins_) 0)
                                                          (+ (cadr blk_obj_ins_) axis_val_)
                                                          (+ (caddr blk_obj_ins_) 0)
                                                        )
                                        )
                )
                (princ "aixs_case_2")
              )
            )
            (;aixs_case_3
