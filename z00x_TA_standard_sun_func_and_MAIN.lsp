                  (= (LM:getdynpropvalue c011_obj_ "view") "7_dynamic_length_view" )
                  (= increment_num_ 0)
              )
              (progn
                (LM:setdynpropvalue c011_obj_ "fragment_middle" (setq c011_obj_fragment_mid_ (- c011_obj_fragment_mid_ 25)))
                (TA:move_polar_insertionpoint  c011_obj_ "Y" 12.5)
