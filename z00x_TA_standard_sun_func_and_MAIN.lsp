            (setq newssset_i (+ newssset_i 1))
          )
        ;
        ;preloop_and_while main_idea for seleciton set for single overlap object
          (setq newssset_i 0)
          (setq check_set_ ())
          (setq check_final_ (ssadd))
          (while (< newssset_i (sslength newssset_))
