)
(defun format-entity-list (data)
  (print "(") ; พิมพ์เปิดวงเล็บ
  (foreach entry data
    (cond
      ((listp entry) ; ตรวจสอบว่าเป็น list ย่อยหรือไม่
      (princ " ")   ; เพิ่มช่องว่าง
      (print entry) ; แสดง list
      )
      (T ; อื่น ๆ เช่น entity name
      (princ " ")   ; เพิ่มช่องว่าง
      (princ entry) ; แสดง entity
      )
    )
  )
  (print ")") ; พิมพ์ปิดวงเล็บ
)



























