                          ; (setq newssset_set2_  (ssdel newssset_ename_set2_ newssset_set2_))
                        )
                        (setq ss "1")
                      )
                    )
                    (progn
                      
                      (setq check_final_ (ssadd newssset_ename_ check_final_))
                      (setq newssset_ (ssdel newssset_ename_ newssset_))
                      (setq newssset_set2_ (ssdel newssset_ename_set2_ newssset_set2_))
                      
                      ; (command "pselect"  check_final_ "") 
                    )
