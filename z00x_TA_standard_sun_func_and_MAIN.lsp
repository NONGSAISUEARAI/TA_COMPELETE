  (defun TA:Aassembly_all_nest_block (blkName / blkEnt ent elist result)
    (setq blkEnt (tblobjname "BLOCK" blkName))

    (while (setq blkEnt (entnext blkEnt))
      (setq elist (entget blkEnt))

      (if (= (cdr (assoc 0 elist)) "ENDBLK")
