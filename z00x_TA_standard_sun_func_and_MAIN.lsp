(defun TA:Combine-SS (ss1 ss2 / newSS i ent)
  (setq newSS (ssadd)) ; สร้าง selection set ว่าง
  
  ;; ใส่สมาชิกจาก ss1
  (if ss1
    (progn
      (setq i 0)
      (while (< i (sslength ss1))
        (setq ent (ssname ss1 i))
        (ssadd ent newSS)
        (setq i (1+ i))
      )
    )
  )

  ;; ใส่สมาชิกจาก ss2
  (if ss2
    (progn
      (setq i 0)
      (while (< i (sslength ss2))
        (setq ent (ssname ss2 i))
        (ssadd ent newSS)
        (setq i (1+ i))
      )
    )
  )

  newSS ; return selection set ที่รวมแล้ว
)
