    (defun TA:is-scientific (n)
      (if 
        (or 
          (= (type n) 'real)
          (= (type n) 'ins)
        )
        (progn
          (if (wcmatch (strcase (rtos n 2 100)) "*E*")
            (progn
              T
            )
          )
        )
        nil
      )
    )
    (defun TA:fixprecision (n)
      (if 
        (or 
          (= (type n) 'real)
          (= (type n) 'ins)
        )
        (progn
          (setq n (- (fix n) n))
          (if (and 
                (/= n 0 )
                (< n 0.00000001 )
                (> n -1 )
              )
            (progn
              (fix n)
            )
          )
        )
        nil
      )
      
    )
    (defun TA:prefix_value (n)  
      (cond  
        ( ;_case_1 
         (and 
           (> n 0)
           (< n 10)
         )
         (progn 
           (strcat "000" (rtos n 2 0))
         )
        )
        ( ;_case_1
         (and 
           (>= n 10)
           (< n 100) 
         )
         (progn 
           (strcat "00" (rtos n 2 0))
         )
        )
        ( ;_case_1
         (and 
           (>= n 100)
           (< n 1000)
         )
         (progn 
           (strcat "0" (rtos n 2 0))
         )
        )
        ( ;_case_1
         (and 
           (>= n 1000) 
         )
         (progn 
           (strcat  (rtos n 2 0)) 
         )
        )
        
      )
    )
