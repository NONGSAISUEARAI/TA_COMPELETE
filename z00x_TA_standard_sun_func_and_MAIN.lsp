    (defun TA:GroupSum_ (lst / result head_ val found)
      (foreach item lst
        (setq head_ (car item))
        (setq val (cadr item))

        (if (setq found (assoc head_ result))
          ;; ถ้ามี head_ อยู่แล้ว → บวกเพิ่ม
          (setq result
            (subst
              (list head_ (+ val (cadr found)))
              found
              result
            )
          )
          ;; ถ้ายังไม่มี → เพิ่มใหม่
          (setq result
            (cons (list head_ val) result)
          )
        )
      )

      (reverse result)
    )
    (defun TA:find-all-indexes (val lst / idx result)
      (setq idx 0)
      (setq result '())
      (while lst
        (if (equal (car lst) val)
          (setq result (cons idx result))
        )
        (setq idx (1+ idx))
        (setq lst (cdr lst))
      )
      (reverse result)
    )
